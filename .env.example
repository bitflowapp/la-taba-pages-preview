# Copiar a .env sólo para herramientas locales. .env está ignorado por Git.
# Nunca usar claves privadas/de servidor ni JWT privilegiados en el navegador.
TABA_DEPLOYMENT_ENVIRONMENT=staging
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
TABA_BUSINESS_ID=00000000-0000-4000-8000-000000000000
TABA_PUBLIC_ORIGIN=https://staging.example.com
TABA_AUTH_REDIRECT_URL=https://staging.example.com/
TABA_ALLOWED_ORIGINS=https://staging.example.com,http://localhost:4173
TABA_RUNTIME_CONFIG_PATH=runtime-config.js

# Sólo para el smoke test manual contra staging; exige confirmación explícita.
TABA_SMOKE_CONFIRM=
TABA_SMOKE_CUSTOMER_EMAIL=
TABA_SMOKE_CUSTOMER_PASSWORD=
TABA_SMOKE_STAFF_EMAIL=
TABA_SMOKE_STAFF_PASSWORD=
TABA_SMOKE_RIDER_EMAIL=
TABA_SMOKE_RIDER_PASSWORD=

# Configuración operativa; permanece fail-closed si el negocio no la aprueba.
TABA_ORDER_RATE_LIMIT_PER_10_MINUTES=
TABA_MAX_PENDING_ORDERS_PER_CUSTOMER=
TABA_STOCK_RESERVATION_MINUTES=
TABA_ABANDONED_ORDER_MINUTES=
TABA_CAPTCHA_REQUIRED=
