node_modules/
**/node_modules/
.env
**/.env
# Sesiones de navegador de la prueba de venta real y su lock. Son credenciales
# vivas de producción: se generan a mano con `npm run e2e:auth:*` y NUNCA se
# versionan. Tampoco viajan al paquete publicado: `create-release-folder.mjs`
# copia una lista blanca y `.local/` no está en ella.
.local/
test-results/
test-results-certification/
playwright-report/
dist_release/
dist-desktop/
src-tauri/target/
scripts/catalog-images/.raw/
.local-staging/
artifacts/release-preparation/
artifacts/taba2-catalog-authority/
artifacts/taba2-catalog-finalization/
artifacts/taba2-storefront-motion/
artifacts/taba2-tracking-visual/
artifacts/windows-release/
artifacts/ci/
# La evidencia de la prueba de venta real: capturas de la pantalla de un cliente
# y de un pedido de produccion. Se redacta antes de escribirse, pero no viaja al
# repositorio de todos modos.
artifacts/production-sale-e2e/
artifacts/alt-candidates/
artifacts/alt-candidates-contact.png
artifacts/local-bebidas-contact.png
test-output.txt
e2e-output*.txt
verify-technical-output.txt
importer-*.txt
local-*.json
catalog/photo-intake/validation.json
catalog/photo-intake/review.json
catalog/photo-intake/ingest-report.json
artifacts/taba2-commercial-audit/

# Evidencia de las corridas del piloto: capturas, sesiones y medidas.
# Es local y puede contener datos de una entrega real; nunca se versiona.
.taba-evidencia/
# Capturas del pulido de lanzamiento: se generan con scripts/launch-ux-captures.mjs
# y viven fuera de Git, como el resto de la revisión visual humana.
artifacts/launch-ux-polish/**/*.png
artifacts/launch-ux-microfix/**/*.png
artifacts/catalog-glow/**/*.png
# Fases del laboratorio del brillo: las medidas de una comparación concreta
# (A/B/C, antes/después de un pulido) sirven mientras se está mirando y después
# quedan viejas. La evidencia que SÍ se versiona es
# `artifacts/catalog-glow/after/MEDIDAS.json`, porque la genera un guion del
# repo y por lo tanto se puede volver a sacar.
artifacts/catalog-glow/polish-*/
artifacts/catalog-glow/abc/

# Las imágenes fuente que se bajan para MIRARLAS antes de aprobar. Son material
# de revisión, no del producto: el repositorio versiona los WebP normalizados y
# sus hashes, no los originales del CDN de la marca.
artifacts/taba2-catalog-images/revision/
