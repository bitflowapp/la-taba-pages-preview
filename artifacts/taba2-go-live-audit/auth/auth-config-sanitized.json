    "mailer_templates_confirmation_content": "<div style=\"font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.5;color:#111;max-width:520px\">\n  <h2 style=\"font-size:20px;margin:0 0 12px\">Confirmá tu cuenta</h2>\n  <p style=\"margin:0 0 12px\">Alguien creó una cuenta en <strong>La Taba</strong> con este correo. Confirmala para poder entrar.</p>\n  <p style=\"margin:0 0 20px\">\n    <a href=\"{{ .SiteURL }}/cuenta/?token_hash={{ .TokenHash }}&type=signup\"\n       style=\"display:inline-block;padding:12px 20px;background:#d71920;color:#fff;text-decoration:none;border-radius:8px;font-weight:600\">Confirmar mi cuenta</a>\n  </p>\n  <p style=\"margin:0 0 12px;color:#555\">El enlace sirve una sola vez y vence en una hora.</p>\n  <p style=\"margin:0 0 12px;color:#555\">Confirmar el correo no te da acceso al Panel: después de confirmar, pedile acceso al comercio y alguien lo revisa.</p>\n  <p style=\"margin:0;color:#555\">Si no fuiste vos, ignorá este mensaje. Sin confirmar, la cuenta no se puede usar.</p>\n</div>",
    "mailer_templates_email_change_content": "<div style=\"font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.5;color:#111;max-width:520px\">\n  <h2 style=\"font-size:20px;margin:0 0 12px\">Confirmá tu correo nuevo</h2>\n  <p style=\"margin:0 0 12px\">Pediste cambiar el correo de tu cuenta de <strong>La Taba</strong> a {{ .NewEmail }}.</p>\n  <p style=\"margin:0 0 20px\">\n    <a href=\"{{ .SiteURL }}/cuenta/?token_hash={{ .TokenHash }}&type=email_change\"\n       style=\"display:inline-block;padding:12px 20px;background:#d71920;color:#fff;text-decoration:none;border-radius:8px;font-weight:600\">Confirmar el correo nuevo</a>\n  </p>\n  <p style=\"margin:0 0 12px;color:#555\">El cambio necesita que confirmes desde las dos casillas, la vieja y la nueva. El enlace vence en una hora.</p>\n  <p style=\"margin:0;color:#555\">Si no lo pediste vos, no hagas nada: el correo de la cuenta no cambia.</p>\n</div>",
    "mailer_templates_invite_content": "<div style=\"font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.5;color:#111;max-width:520px\">\n  <h2 style=\"font-size:20px;margin:0 0 12px\">Te invitaron a La Taba</h2>\n  <p style=\"margin:0 0 12px\">El comercio te invitó a trabajar con <strong>La Taba</strong>. Elegí tu contraseña para activar la cuenta.</p>\n  <p style=\"margin:0 0 20px\">\n    <a href=\"{{ .SiteURL }}/cuenta/?token_hash={{ .TokenHash }}&type=invite\"\n       style=\"display:inline-block;padding:12px 20px;background:#d71920;color:#fff;text-decoration:none;border-radius:8px;font-weight:600\">Activar mi cuenta</a>\n  </p>\n  <p style=\"margin:0 0 12px;color:#555\">El enlace sirve una sola vez y vence en una hora.</p>\n  <p style=\"margin:0;color:#555\">Si no esperabas esta invitación, ignorá este mensaje.</p>\n</div>",
    "mailer_templates_magic_link_content": "<div style=\"font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.5;color:#111;max-width:520px\">\n  <h2 style=\"font-size:20px;margin:0 0 12px\">Tu enlace para entrar</h2>\n  <p style=\"margin:0 0 12px\">Pediste entrar a <strong>La Taba</strong> con un enlace en vez de contraseña.</p>\n  <p style=\"margin:0 0 20px\">\n    <a href=\"{{ .SiteURL }}/cuenta/?token_hash={{ .TokenHash }}&type=magiclink\"\n       style=\"display:inline-block;padding:12px 20px;background:#d71920;color:#fff;text-decoration:none;border-radius:8px;font-weight:600\">Entrar</a>\n  </p>\n  <p style=\"margin:0 0 12px;color:#555\">El enlace sirve una sola vez y vence en una hora.</p>\n  <p style=\"margin:0;color:#555\">Si no lo pediste vos, ignorá este mensaje.</p>\n</div>",
    "mailer_templates_reauthentication_content": "<div style=\"font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.5;color:#111;max-width:520px\">\n  <h2 style=\"font-size:20px;margin:0 0 12px\">Tu código de verificación</h2>\n  <p style=\"margin:0 0 12px\">Usá este código para confirmar que sos vos:</p>\n  <p style=\"margin:0 0 20px;font-size:28px;font-weight:700;letter-spacing:4px\">{{ .Token }}</p>\n  <p style=\"margin:0 0 12px;color:#555\">El código vence en una hora y sirve una sola vez.</p>\n  <p style=\"margin:0;color:#555\">Si no estabas cambiando nada de tu cuenta, no lo uses y avisale al comercio.</p>\n</div>",
    "mailer_templates_recovery_content": "<div style=\"font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.5;color:#111;max-width:520px\">\n  <h2 style=\"font-size:20px;margin:0 0 12px\">Cambiá tu contraseña</h2>\n  <p style=\"margin:0 0 12px\">Pediste cambiar la contraseña de tu cuenta de <strong>La Taba</strong>.</p>\n  <p style=\"margin:0 0 20px\">\n    <a href=\"{{ .SiteURL }}/cuenta/?token_hash={{ .TokenHash }}&type=recovery\"\n       style=\"display:inline-block;padding:12px 20px;background:#d71920;color:#fff;text-decoration:none;border-radius:8px;font-weight:600\">Elegir una contraseña nueva</a>\n  </p>\n  <p style=\"margin:0 0 12px;color:#555\">El enlace sirve una sola vez y vence en una hora.</p>\n  <p style=\"margin:0;color:#555\">Si no lo pediste vos, no hagas nada: tu contraseña actual sigue funcionando.</p>\n</div>",
    "mailer_templates_password_changed_notification_content": "(PRESENTE, valor redactado)",
    "mailer_templates_email_changed_notification_content": "<h2>Your email address was changed</h2>\n\n<p>The email address for your account was changed from {{ .OldEmail }} to {{ .Email }}.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
    "mailer_templates_phone_changed_notification_content": "<h2>Your phone number was changed</h2>\n\n<p>The phone number for your account was changed from {{ .OldPhone }} to {{ .Phone }}.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
    "mailer_templates_mfa_factor_enrolled_notification_content": "<h2>A new verification method was added</h2>\n\n<p>Sign-in verification method {{ .FactorType }} was added to your account.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
    "mailer_templates_mfa_factor_unenrolled_notification_content": "<h2>A verification method was removed</h2>\n\n<p>Sign-in verification method {{ .FactorType }} was removed from your account.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
    "mailer_templates_identity_linked_notification_content": "<h2>A new sign-in method was linked</h2>\n\n<p>Your {{ .Provider }} account was linked as a new sign-in method for {{ .Email }}.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
