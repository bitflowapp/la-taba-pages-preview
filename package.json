{
  "name": "la-taba-pages-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/check-static-assets.mjs && node scripts/check-release-hygiene.mjs",
    "vendor:build": "node scripts/build-supabase-vendor.mjs",
    "test": "node --import ./tests/test-bootstrap.mjs --test --test-concurrency=1",
    "test:e2e": "playwright test",
    "fiscal:install": "npm --prefix services/arca-fiscal-bridge ci",
    "fiscal:build": "npm --prefix services/arca-fiscal-bridge run build",
    "fiscal:test": "npm --prefix services/arca-fiscal-bridge test",
    "verify:technical": "npm run check && npm test && npm run fiscal:test && npm run test:e2e",
    "verify": "npm run migrations:validate && npm run catalog:release:validate && npm run verify:technical",
    "release:folder": "npm run vendor:build && npm run verify && node scripts/create-release-folder.mjs",
    "smoke:supabase": "node scripts/smoke-supabase-production.mjs",
    "smoke:business-intake:staging": "node scripts/run-business-intake-staging-smoke.mjs",
    "config:check": "node scripts/check-runtime-config.mjs",
    "migrations:validate": "node scripts/validate-supabase-migrations.mjs",
    "catalog:validate": "node scripts/validate-product-catalog.mjs",
    "catalog:template:validate": "node scripts/validate-product-catalog.mjs data/catalog-template.csv --template",
    "catalog:import": "node scripts/import-product-catalog.mjs",
    "catalog:images:fetch": "node scripts/catalog-images/fetch-approved.mjs",
    "catalog:images:normalize": "node scripts/catalog-images/normalize.mjs",
    "catalog:images:verify": "node scripts/catalog-images/verify-approved-demo.mjs && node scripts/catalog-images/verify.mjs --allow-empty",
    "catalog:release:validate": "node scripts/validate-release-catalog.mjs",
    "staging:validate": "node scripts/validate-staging-readiness.mjs",
    "realtime:demo": "node scripts/realtime-relay.mjs",
    "desktop:assets": "node scripts/build-desktop-assets.mjs",
    "tauri": "tauri",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.28.1",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  }
}
