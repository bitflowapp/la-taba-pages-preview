{
  "name": "la-taba-pages-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/check-static-assets.mjs",
    "vendor:build": "node scripts/build-supabase-vendor.mjs",
    "test": "node --test --test-concurrency=1",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run test:e2e",
    "release:folder": "npm run vendor:build && npm run verify && node scripts/create-release-folder.mjs",
    "smoke:supabase": "node scripts/smoke-supabase-production.mjs",
    "realtime:demo": "node scripts/realtime-relay.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  }
}
