# Sólo nombres. Los valores viven en el secret manager del entorno y los tres
# secretos (certificado, clave privada y service role) se montan como archivos
# absolutos fuera del repositorio.
ARCA_ENVIRONMENT=disabled
ARCA_CUIT=
ARCA_CERTIFICATE_PATH=
ARCA_PRIVATE_KEY_PATH=
ARCA_HOMOLOGATION_CONSENT=
ARCA_PRODUCTION_ENABLE=
# Ruta absoluta donde el puente guarda el Ticket de Acceso entre reinicios.
# WSAA retiene el TA vigente y rechaza pedidos repetidos dentro de una ventana
# (10 minutos en homologación); sin este archivo, reiniciar el worker lo deja
# bloqueado hasta que esa ventana venza. El archivo se escribe con permisos 600
# y contiene un secreto de corta vida: no va al repositorio ni a los logs.
ARCA_TICKET_STATE_PATH=
# Tolerancia, en segundos, entre el reloj local y el de ARCA antes de fallar
# cerrado. El manual de WSAA exige el equipo sincronizado por NTP en GMT-3.
ARCA_MAX_CLOCK_SKEW_SECONDS=300
# UUID del negocio al que este puente le publica la salud de credenciales.
FISCAL_BUSINESS_ID=
FISCAL_WORKER_ID=taba-fiscal-worker-01
FISCAL_HEALTH_PORT=8787
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_PATH=
