    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "node-forge": "1.4.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/node-forge": "1.3.14",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2"
  }
}
