{
  "name": "@taba/arca-fiscal-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "credentials:check": "npm run build && node dist/src/check-credentials.js",
